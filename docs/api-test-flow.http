@baseUrl = http://localhost:8080/api/v1
@password = Password@123

### 01 - Login E2E Super Admin and initialize one API run
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept-Language: vi

{
  "email": "e2e.superadmin@fap.local",
  "password": "{{password}}"
}

> {%
client.test("Super Admin login succeeds", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
});
client.global.set("accessToken", response.body.data.accessToken);
const runId = Date.now().toString();
const today = new Date();
const future = new Date(today);
const classEnd = new Date(today);
future.setDate(today.getDate() + 14);
classEnd.setDate(today.getDate() + 90);
client.global.set("runId", runId);
client.global.set("today", today.toISOString().slice(0, 10));
client.global.set("futureDate", future.toISOString().slice(0, 10));
client.global.set("futureStart", future.toISOString().slice(0, 10) + "T09:00:00");
client.global.set("futureEnd", future.toISOString().slice(0, 10) + "T11:00:00");
client.global.set("classEnd", classEnd.toISOString().slice(0, 10));
%}

### 02 - Load real role IDs
GET {{baseUrl}}/roles
Authorization: Bearer {{accessToken}}
Accept-Language: vi

> {%
const roles = response.body.data;
client.global.set("classAdminRoleId", roles.find(r => r.name === "Class Admin").id);
client.global.set("trainerRoleId", roles.find(r => r.name === "Trainer").id);
client.global.set("traineeRoleId", roles.find(r => r.name === "Trainee").id);
%}

### 03 - Create Class Admin for this run
POST {{baseUrl}}/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept-Language: vi

{
  "fullName": "API Flow Class Admin {{runId}}",
  "email": "flow.classadmin.{{runId}}@fap.local",
  "phone": "0903000001",
  "password": "{{password}}",
  "dateOfBirth": "1990-01-15",
  "gender": "Male",
  "roleIds": [{{classAdminRoleId}}]
}

> {% client.global.set("classAdminUserId", response.body.data.id); %}

